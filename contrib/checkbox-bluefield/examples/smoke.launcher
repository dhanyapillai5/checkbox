[launcher]
launcher_version = 1
app_id = com.canonical.contrib.bluefield:smoke
app_version = 0.1.0
stock_reports = text, submission_files
session_title = BlueField smoke

[test plan]
unit = com.canonical.contrib.bluefield::bluefield-image-smoke
forced = yes

[test selection]
forced = yes

[ui]
type = silent

[environment]
BLUEFIELD_EXPECTED_DATASOURCE = REPLACE_WITH_DATASOURCE
BLUEFIELD_MAAS_NETWORK_CONFIG = /REPLACE_WITH_REFERENCE_DIRECTORY/maas-network-reference.yaml
BLUEFIELD_EXPECTED_KERNEL = REPLACE_WITH_KERNEL_RELEASE
BLUEFIELD_REQUIRED_BOOT_ARGS = REPLACE_WITH_REQUIRED_ARGUMENTS
BLUEFIELD_FORBIDDEN_BOOT_ARGS =
BLUEFIELD_CANDIDATE_INVENTORY = /REPLACE_WITH_REFERENCE_DIRECTORY/package-inventory.tsv
BLUEFIELD_REQUIRED_PACKAGES = REPLACE_WITH_REQUIRED_PACKAGE_NAMES
BLUEFIELD_REQUIRED_HOLDS = REPLACE_WITH_REQUIRED_HOLD_NAMES
BLUEFIELD_EXPECTED_CONFLICTS = /REPLACE_WITH_REFERENCE_DIRECTORY/expected-conflicts.tsv
BLUEFIELD_REQUIRED_MODULES = REPLACE_WITH_REQUIRED_MODULE_NAMES
BLUEFIELD_EXPECTED_PCI = /REPLACE_WITH_REFERENCE_DIRECTORY/expected-pci.tsv
BLUEFIELD_EXPECTED_INTERFACES = /REPLACE_WITH_REFERENCE_DIRECTORY/expected-interfaces.json
BLUEFIELD_EXPECTED_MANAGEMENT = /REPLACE_WITH_REFERENCE_DIRECTORY/expected-management.json
BLUEFIELD_TEST_TMFIFO_ADDRESS = REPLACE_WITH_TEST_IPV4_PREFIX
BLUEFIELD_REQUIRED_SERVICES = REPLACE_WITH_UNIT_ACTIVE_SUBSTATE_TOKENS
BLUEFIELD_SERVICE_ENABLEMENT = REPLACE_WITH_UNIT_ENABLEMENT_TOKENS
BLUEFIELD_ABSENT_FILES = REPLACE_WITH_ABSOLUTE_PATHS
BLUEFIELD_EXPECTED_RELEASE_SUFFIX = REPLACE_WITH_RELEASE_SUFFIX
BLUEFIELD_EXPECTED_SETTINGS = /REPLACE_WITH_REFERENCE_DIRECTORY/expected-settings.json
BLUEFIELD_OVS_INIT_POLICY = /REPLACE_WITH_REFERENCE_DIRECTORY/ovs-init-policy.json
